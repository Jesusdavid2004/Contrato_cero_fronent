{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["app", "next-lib", "next.config.mjs", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
