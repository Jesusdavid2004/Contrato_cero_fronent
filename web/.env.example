# Variables de ejemplo para el frontend Next.js (sin secretos).
# Desarrollo local: el rewrites /api apunta al backend directo.

# Base HTTP del API Express vista desde el navegador (WSS directo + fallback).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Base HTTP del API vista desde el servidor Next (rewrites y SSR).
# BACKEND_INTERNAL_URL=http://127.0.0.1:3001
